{
  "name": "launchpilot",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @launchpilot/api --filter @launchpilot/web dev",
    "dev:api": "pnpm --filter @launchpilot/api dev",
    "dev:web": "pnpm --filter @launchpilot/web dev",
    "build": "pnpm --filter @launchpilot/agents build && pnpm --filter @launchpilot/api build && pnpm --filter @launchpilot/web build",
    "start": "pnpm -r --parallel --filter @launchpilot/api --filter @launchpilot/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\" --ignore-path .gitignore",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @launchpilot/api db:migrate",
    "db:deploy": "pnpm --filter @launchpilot/api db:deploy",
    "db:status": "pnpm --filter @launchpilot/api db:status",
    "db:seed": "pnpm --filter @launchpilot/api db:seed",
    "db:reset": "pnpm --filter @launchpilot/api db:reset",
    "test": "pnpm --filter @launchpilot/agents test && pnpm --filter @launchpilot/api test",
    "test:agents": "pnpm --filter @launchpilot/agents test",
    "test:api": "pnpm --filter @launchpilot/api test"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
