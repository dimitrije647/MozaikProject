generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  READY
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum IntegrationStatus {
  NOT_CONNECTED
  CONFIGURED
  CONNECTED
  ERROR
}

enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  INTERRUPTED
}

enum ConnectionType {
  OAUTH
  API_KEY
  PLACEHOLDER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  // Provider key (e.g. "openai", "gemini") used by future AI agents. See ApiCredential.
  defaultAiProvider String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects     Project[]
  integrations UserIntegration[]
  credentials  ApiCredential[]
  activity     ActivityLog[]
  runs         CampaignRun[]
  factoryRuns  FactoryRun[]
}

model Project {
  id          String        @id @default(cuid())
  userId      String
  name        String
  slug        String
  description String?
  status      ProjectStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user     User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  intake   ProductIntake?
  assets   ProjectAsset[]
  socials  SocialProfile[]
  formats  CampaignFormatPreference[]
  notes    WorkspaceNote[]
  activity ActivityLog[]
  runs     CampaignRun[]
  reports  ProductDiscoveryReport[]
  audits   MarketingAuditReport[]
  strategies MarketingStrategyReport[]
  campaigns CreativeCampaign[]
  campaignAssets CampaignAsset[]
  factoryRuns FactoryRun[]

  @@unique([userId, slug])
  @@index([userId, updatedAt])
}

model ProductIntake {
  id                      String   @id @default(cuid())
  projectId               String   @unique
  productName             String
  shortDescription        String?
  websiteUrl              String?
  githubUrl               String?
  targetMarket            String?
  targetAudience          String?
  marketingGoal           String?
  preferredLanguage       String   @default("en")
  campaignDuration        String?
  stylePreference         String?
  publishingMode          String   @default("manual")
  enableSeoAudit          Boolean  @default(true)
  enableSeasonalCalendar  Boolean  @default(false)
  enableGoogleDriveExport Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectAsset {
  id           String   @id @default(cuid())
  projectId    String
  type         String // logo | image | screenshot | reference | pdf | doc | other
  originalName String
  mimeType     String
  // Storage key relative to the storage root (see StorageService). Not an absolute path.
  filePath     String
  fileSize     Int
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model SocialProfile {
  id        String   @id @default(cuid())
  projectId String
  platform  String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, platform])
}

model CampaignFormatPreference {
  id         String  @id @default(cuid())
  projectId  String
  formatType String
  enabled    Boolean @default(true)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, formatType])
}

model IntegrationProvider {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  category    String
  description String
  // "oauth" | "api_key" - how the provider is configured in the UI
  authType    String
  isEnabled   Boolean @default(true)
}

model UserIntegration {
  id                String            @id @default(cuid())
  userId            String
  providerKey       String
  status            IntegrationStatus @default(NOT_CONNECTED)
  connectionType    ConnectionType    @default(PLACEHOLDER)
  displayName       String?
  externalAccountId String?
  maskedCredential  String?
  metadataJson      Json?
  connectedAt       DateTime?
  updatedAt         DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerKey])
}

model ApiCredential {
  id           String   @id @default(cuid())
  userId       String
  providerKey  String
  label        String
  maskedKey    String
  // AES-256-GCM payload (iv.tag.ciphertext, base64). Never returned by the API.
  encryptedKey String
  isActive     Boolean  @default(true)
  // Model id the user chose for this provider. Never defaulted or switched automatically.
  model        String?
  // The model for which "Test connection" last succeeded (a real, tiny inference call).
  // Ready to run = model is set AND verifiedModel == model. Replacing the key clears it.
  verifiedModel String?
  verifiedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerKey])
}

model WorkspaceNote {
  id        String   @id @default(cuid())
  projectId String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ActivityLog {
  id            String   @id @default(cuid())
  userId        String
  projectId     String?
  eventType     String
  eventDataJson Json?
  createdAt     DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// One execution of the Mozaik runtime for a project. Persistent record only: the live Mozaik
/// state is in memory and is NOT restored after a restart (such runs become INTERRUPTED).
model CampaignRun {
  id           String    @id @default(cuid())
  projectId    String
  userId       String
  /// "smoke_test" today. Future: "campaign".
  mode         String    @default("smoke_test")
  status       RunStatus @default(RUNNING)
  /// FactoryPhase id; null while no phase has started (always null for the smoke test).
  currentPhase String?
  /// Name of the default AI provider at start ("openai" or "gemini"). Never the key.
  provider     String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events  CampaignEvent[]
  report  ProductDiscoveryReport?
  audit   MarketingAuditReport?
  strategy MarketingStrategyReport?
  campaign CreativeCampaign?

  // A partial unique index (one RUNNING run per project) is added in the migration SQL,
  // because Prisma cannot express partial indexes in the schema.
  @@index([projectId, createdAt])
  @@index([userId])
}

model CampaignEvent {
  id          String   @id @default(cuid())
  runId       String
  /// Monotonic per run; defines event order (createdAt can tie).
  sequence    Int
  eventType   String
  phase       String?
  participant String?
  /// Sanitized payload. Never contains credentials (see redact() in @launchpilot/agents).
  payloadJson Json?
  createdAt   DateTime @default(now())

  run CampaignRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
}

/// Product Discovery output. One report per run; reruns create new rows, nothing is overwritten.
model ProductDiscoveryReport {
  id            String   @id @default(cuid())
  projectId     String
  runId         String   @unique
  schemaVersion Int
  language      String
  /// Model id the user selected for the run (as sent to OpenAI).
  model         String
  /// The validated report (see ProductDiscoveryReport in @launchpilot/agents).
  reportJson    Json
  /// Token usage, agent outcomes, cross-check issues, per-agent findings and the exact input snapshot
  /// the agents saw. Contains the user's own text, never credentials.
  metadataJson  Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run     CampaignRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  audits  MarketingAuditReport[]
  strategies MarketingStrategyReport[]
  campaigns CreativeCampaign[]

  @@index([projectId, createdAt])
}

/// F2 Marketing Audit output. One per run; reruns create new rows, nothing is overwritten.
/// Always tied to the exact F1 report it was built on.
model MarketingAuditReport {
  id            String   @id @default(cuid())
  projectId     String
  runId         String   @unique
  /// The completed F1 Product Discovery report this audit used (exact version).
  f1ReportId    String
  schemaVersion Int
  language      String
  /// Model id the user selected for the run (as sent to OpenAI).
  model         String
  /// The validated Marketing Audit Report (see MarketingAuditReport in @launchpilot/agents).
  reportJson    Json
  /// Token usage, agent outcomes, sources with access type, findings with provenance, cross-checks and the
  /// input snapshot. Contains the user's own project data, never credentials.
  metadataJson  Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project  Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run      CampaignRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  f1Report ProductDiscoveryReport @relation(fields: [f1ReportId], references: [id], onDelete: NoAction)
  strategies MarketingStrategyReport[]
  campaigns CreativeCampaign[]

  @@index([projectId, createdAt])
  @@index([f1ReportId])
}

/// F3 Market Research & Strategy output. One per run; reruns create new rows, nothing is overwritten.
/// Always tied to the exact F1 report and F2 audit it was built on.
model MarketingStrategyReport {
  id            String   @id @default(cuid())
  projectId     String
  runId         String   @unique
  /// The completed F1 Product Discovery report this strategy used (exact version).
  f1ReportId    String
  /// The completed F2 Marketing Audit this strategy used (exact version).
  f2AuditId     String
  schemaVersion Int
  language      String
  /// Model id the user selected for the run (as sent to OpenAI).
  model         String
  /// The validated Campaign Strategy Report (see CampaignStrategyReport in @launchpilot/agents), incl. the F4 creative brief.
  reportJson    Json
  /// Token usage, plan with the dynamically created Channel Scouts, sources with access type, findings with
  /// provenance, cross-checks and the input snapshot. Contains the user's project data, never credentials.
  metadataJson  Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project  Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run      CampaignRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  f1Report ProductDiscoveryReport @relation(fields: [f1ReportId], references: [id], onDelete: NoAction)
  f2Audit  MarketingAuditReport   @relation(fields: [f2AuditId], references: [id], onDelete: NoAction)
  campaigns CreativeCampaign[]

  @@index([projectId, createdAt])
  @@index([f1ReportId])
  @@index([f2AuditId])
}

/// F4 Creative Production output. One campaign per run: the row is created when the run starts (its assets are stored under
/// it while the run is in progress) and completed with the validated Campaign Package. Always tied to the exact F1 report,
/// F2 audit and F3 strategy it was built on. Reruns create new rows; a completed campaign is never overwritten.
model CreativeCampaign {
  id             String   @id @default(cuid())
  projectId      String
  runId          String   @unique
  f1ReportId     String
  f2AuditId      String
  f3StrategyId   String
  schemaVersion  Int
  language       String
  /// Text model id the user selected for the run (as sent to OpenAI).
  model          String
  /// Image model id the user selected (gpt-image-*), or null when no image was generated.
  imageModel     String?
  /// running | completed | failed | cancelled | interrupted (mirrors the run; set when the run ends).
  status         String   @default("running")
  campaignName   String
  /// approved | approved_with_notes | unresolved, once the package exists.
  approvalStatus String?
  /// The validated Campaign Package (see CampaignPackage in @launchpilot/agents). Null until the run completes.
  packageJson    Json?
  /// Usage, participants, cross-checks, plan and the settings snapshot. Never credentials, never image binaries.
  metadataJson   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project    Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run        CampaignRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  f1Report   ProductDiscoveryReport  @relation(fields: [f1ReportId], references: [id], onDelete: NoAction)
  f2Audit    MarketingAuditReport    @relation(fields: [f2AuditId], references: [id], onDelete: NoAction)
  f3Strategy MarketingStrategyReport @relation(fields: [f3StrategyId], references: [id], onDelete: NoAction)
  assets     CampaignAsset[]

  @@index([projectId, createdAt])
  @@index([f3StrategyId])
}

/// One stored image file of a campaign: a generated base image or a rendered channel layout. The binary lives in project
/// storage (filePath is a storage key, served only through an authenticated endpoint); only metadata is here. Superseded
/// versions are kept: an original is never overwritten by a repair.
model CampaignAsset {
  id            String   @id @default(cuid())
  campaignId    String
  projectId     String
  /// image | layout
  kind          String
  conceptId     String
  channel       String?
  format        String?
  version       Int      @default(1)
  parentAssetId String?
  mimeType      String
  width         Int
  height        Int
  bytes         Int
  sha256        String
  /// ai_image | brand_gradient
  source        String
  model         String?
  quality       String?
  requestedSize String?
  /// generated | rendered | superseded | failed
  status        String
  filePath      String
  altText       String?
  /// Layout flags, prompt metadata (length and a short summary only, never the prompt) and provider-reported usage.
  metadataJson  Json?
  createdAt     DateTime @default(now())

  campaign CreativeCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([projectId])
}

/// One full-campaign run. A deterministic orchestrator drives the EXISTING phase runs (F1 Product Discovery, F2 Marketing Audit,
/// F3 Market Research & Strategy, F4 Creative Production) in order, reusing compatible saved results or running the phase for
/// real. Every state transition is stored here, so a browser refresh or a server restart never loses or invents progress.
/// Child runs are ordinary CampaignRun rows (their events are the agent activity); this row only links and sequences them.
model FactoryRun {
  id              String    @id @default(cuid())
  projectId       String
  userId          String
  /// continue (reuse compatible saved results) | fresh (run every phase)
  mode            String
  /// queued | running | completed | partial | failed | cancelled | interrupted
  status          String    @default("queued")
  /// discovery | audit | strategy | creative while a phase is running; null otherwise.
  currentPhase    String?
  cancelRequested Boolean   @default(false)
  /// The settings snapshot the user confirmed (models, limits, channels). Never credentials.
  configJson      Json
  /// The four phases: action (run | reuse), status, child run id, saved output id, timestamps and a safe error message.
  phasesJson      Json
  /// Honest notes (partial inputs reused, a requested channel the strategy did not recommend, ...).
  warningsJson    Json      @default("[]")
  /// The exact chain in use (F4 -> this F3 -> this F2 -> this F1), filled as each result is resolved or saved.
  f1ReportId      String?
  f2AuditId       String?
  f3StrategyId    String?
  /// The saved campaign (F4) once the package exists.
  campaignId      String?
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A partial unique index (one queued/running factory run per project) is added in the migration SQL,
  // because Prisma cannot express partial indexes in the schema.
  @@index([projectId, createdAt])
  @@index([userId])
}
