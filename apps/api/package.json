{
  "name": "@launchpilot/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @launchpilot/agents build && dotenv -e ../../.env -- nest start --watch",
    "build": "pnpm --filter @launchpilot/agents build && prisma generate && nest build",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "typecheck": "pnpm --filter @launchpilot/agents build && tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "test": "dotenv -e ../../.env -- jest"
  },
  "dependencies": {
    "@launchpilot/agents": "workspace:*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.1.0",
    "jest": "^29",
    "prisma": "6.19.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
