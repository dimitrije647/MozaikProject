# ---- Database ----
DATABASE_URL="postgresql://launchpilot:launchpilot@localhost:5433/launchpilot?schema=public"

# ---- API ----
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
# Long random string used to sign session JWTs (openssl rand -base64 48)
JWT_SECRET="change-me-to-a-long-random-string"
# Master secret for encrypting stored API keys (BYOK). Any long random string.
APP_ENCRYPTION_KEY="change-me-to-another-long-random-string"
# Local upload directory (relative to apps/api). Swap the storage driver for S3 later.
UPLOAD_DIR="./uploads"

# ---- Web ----
# Where the Next.js server proxies /api/* to
API_URL="http://localhost:4000"

# ---- Agents package (packages/agents, not wired to the app yet) ----
MOZAIK_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# ---- Product Discovery tools (all optional; keys stay on the server, never in the browser) ----
# Web search provider for the Web Analyzer (F1) and the Competitor Researcher (F3). The same key also enables the
# Tavily Extract fallback that reads JavaScript-rendered and bot-protected pages (used only when the plain fetch yields
# no text). Without it, only the user's own website is read as served (no general search, no rendering fallback).
TAVILY_API_KEY=
# Alternative provider, used only if TAVILY_API_KEY is empty.
BRAVE_SEARCH_API_KEY=
# Raises the GitHub API rate limit for the Repo Analyzer (60 -> 5000 requests/hour). Needs no scopes for public repos.
GITHUB_TOKEN=

# ---- Marketing Audit (F2) tools (optional) ----
# Google PageSpeed Insights API v5. Without a key PageSpeed is NOT called and performance metrics are reported as unavailable.
PAGESPEED_API_KEY=
# YouTube Data API v3 (public channel data). Without a key no live YouTube data is requested.
YOUTUBE_API_KEY=

# Mozaik Cloud telemetry is OFF by default (LaunchPilot blanks MOZAIK_API_KEY at runtime). To opt in deliberately:
#   LAUNCHPILOT_MOZAIK_CLOUD=on  plus MOZAIK_API_KEY=...   (payloads are redacted to event types unless MOZAIK_REDACTION is set)
