# ---- Database ----
DATABASE_URL="postgresql://launchpilot:launchpilot@localhost:5433/launchpilot?schema=public"

# ---- API ----
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
# Long random string used to sign session JWTs (openssl rand -base64 48)
JWT_SECRET="change-me-to-a-long-random-string"
# Master secret for encrypting stored API keys (BYOK). Any long random string.
APP_ENCRYPTION_KEY="change-me-to-another-long-random-string"
# Local upload directory (relative to apps/api). Swap the storage driver for S3 later.
UPLOAD_DIR="./uploads"

# ---- Web ----
# Where the Next.js server proxies /api/* to
API_URL="http://localhost:4000"

# ---- Agents package (packages/agents, not wired to the app yet) ----
MOZAIK_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# ---- Product Discovery tools (all optional; keys stay on the server, never in the browser) ----
# Web search provider for the Web Analyzer (F1) and the Competitor Researcher (F3). The same key also enables the
# Tavily Extract fallback that reads JavaScript-rendered and bot-protected pages (used only when the plain fetch yields
# no text). Without it, only the user's own website is read as served (no general search, no rendering fallback).
TAVILY_API_KEY=
# Alternative provider, used only if TAVILY_API_KEY is empty.
BRAVE_SEARCH_API_KEY=
# Raises the GitHub API rate limit for the Repo Analyzer (60 -> 5000 requests/hour). Needs no scopes for public repos.
GITHUB_TOKEN=

# ---- Marketing Audit (F2) tools (optional) ----
# Google PageSpeed Insights API v5. Without a key PageSpeed is NOT called and performance metrics are reported as unavailable.
PAGESPEED_API_KEY=
# YouTube Data API v3 (public channel data). Without a key no live YouTube data is requested.
YOUTUBE_API_KEY=

# Mozaik Cloud telemetry is OFF by default (LaunchPilot blanks MOZAIK_API_KEY at runtime). To opt in deliberately:
#   LAUNCHPILOT_MOZAIK_CLOUD=on  plus MOZAIK_API_KEY=...   (payloads are redacted to event types unless MOZAIK_REDACTION is set)

# ---- Pinterest (OPTIONAL visual-inspiration panel; LaunchPilot works fully without it) ----
# Create an app in the Pinterest developer portal, register the redirect URI below EXACTLY, and fill these three.
# Leave them empty and the Pinterest panel just says "not configured". Read-only scopes only (boards:read, pins:read).
# Pinterest must approve the app before it can read real boards; see the README section "Pinterest (optional)".
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Where Pinterest sends the browser back, e.g. http://localhost:3000/api/integrations/pinterest/callback (https outside localhost)
PINTEREST_REDIRECT_URI=
# Optional: https://api-sandbox.pinterest.com to use Pinterest's sandbox host. Only official Pinterest hosts are accepted.
# PINTEREST_API_BASE=
# Only for Pinterest apps created before 2025-09-25: set to 1 to request a continuous refresh token.
# PINTEREST_CONTINUOUS_REFRESH=
# Local mock servers only (never honored when NODE_ENV=production): PINTEREST_ALLOW_TEST_BASE=1 plus a custom PINTEREST_API_BASE.
# PINTEREST_ALLOW_TEST_BASE=

# ---- Web visual discovery (OPTIONAL: licensed pictures and inspiration; LaunchPilot works fully without any of it) ----
# A fresh install contacts NO image provider. Each provider below is switched on only by its own setting, and nothing is invented when none is.
# Licensed stock (a picture is only added to a project when YOU choose it; its license and credit are recorded with it):
#   Pixabay: free key at https://pixabay.com/api/docs/ (Pixabay Content License: commercial use and cropping/text overlays allowed)
PIXABAY_API_KEY=
#   Pexels: existing keys only (Pexels has paused issuing new ones). Pexels License.
PEXELS_API_KEY=
#   Openverse (Creative Commons search; every result still needs a license check at its source). No key needed: set to true to switch it on.
OPENVERSE_ENABLED=
# OPENVERSE_TOKEN=
# Reference-only web image search through Brave (uses BRAVE_SEARCH_API_KEY above). Results are for LOOKING at: never downloaded, never used in a creative.
# Pinterest results are shown as links only. Set to on to enable.
LAUNCHPILOT_REFERENCE_IMAGE_SEARCH=
